 8px; background: url("https://lupic.cdn.bcebos.com/static/wap_insert_scree=
n_finger.png") center center / cover no-repeat; width: 60px; height: 60px; =
animation: 1s ease-in-out 0s infinite normal both running finger; z-index: =
999; }

