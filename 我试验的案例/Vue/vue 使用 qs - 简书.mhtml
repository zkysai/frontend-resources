@charset "utf-8";

html, body { margin: 0px; }

.container { box-sizing: border-box; position: relative; }

a { text-decoration: none; }

.pic_container { width: 100%; height: 200px; overflow: hidden; position: re=
lative; }

.picDiv img { width: 100%; height: 100%; display: block; transition: transf=
orm 0.5s ease-in; }

.picDiv img:hover { transform: scale(1.1); }

.picDiv { overflow: hidden; }

.adTitle:hover { color: rgb(232, 0, 7) !important; }

.onlyOne { width: 100%; height: 100%; }

.doubleLeft { float: left; height: 100%; width: calc(50% - 1px); box-sizing=
: border-box; border: 1px solid rgb(228, 228, 228); }

.doubleRight { float: right; width: calc(50% - 1px); height: 100%; box-sizi=
ng: border-box; border: 1px solid rgb(228, 228, 228); }

.threeLeft { float: left; height: 100%; width: calc(66.6% - 1px); box-sizin=
g: border-box; border: 1px solid rgb(228, 228, 228); }

.threeRight { float: right; height: 100%; width: calc(33.4% - 1px); }

.three-right-top { height: calc(50% - 1px); margin-bottom: 2px; width: 100%=
; box-sizing: border-box; border: 1px solid rgb(228, 228, 228); }

.three-right-bottom { height: calc(50% - 1px); width: 100%; box-sizing: bor=
der-box; border: 1px solid rgb(228, 228, 228); }

